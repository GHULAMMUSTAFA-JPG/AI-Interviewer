# ══════════════════════════════════════════════════════════════════════
# AI Interviewer — Root Environment File
#
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# DO NOT commit .env to version control.
#
# MONGODB_URI is overridden per-service in docker-compose.yml to point
# to the internal "mongodb" container. You only need to set it here if
# you want to use a local script (e.g. setup_db.py) from the host.
# ══════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────
# MongoDB (host-side access only)
# In Docker, each service uses: mongodb://mongodb:27017/?replicaSet=rs0
# ─────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=interviews


# ─────────────────────────────────────────
# Main-Agent — LLM settings
# ─────────────────────────────────────────
LLM_PROVIDER=gemini

# Gemini (default provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_CONVERSATION=gemini-2.0-flash-lite
GEMINI_MODEL_EVALUATION=gemini-2.0-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.9

# OpenAI (set LLM_PROVIDER=openai to use)
# OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo

# Anthropic (set LLM_PROVIDER=anthropic to use)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4

# Interview safeguards
SOFT_DURATION_LIMIT_MINUTES=90
HARD_DURATION_LIMIT_MINUTES=0
CONTEXT_WARNING_TOKENS=150000
CONTEXT_MAX_TOKENS=180000
SILENCE_TIMEOUT_SECONDS=180

# Performance
MAX_CONCURRENT_INTERVIEWS=50
LLM_TIMEOUT_SECONDS=10
CACHE_MAX_SIZE=1000
CACHE_TTL_SECONDS=7200


# ─────────────────────────────────────────
# TTS — ElevenLabs settings
# ─────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_22050
TRANSCRIPTS_COLLECTION=transcripts

# Audio output device ID
# Run: docker compose exec tts uv run python -c "import sounddevice as sd; print(sd.query_devices())"
# Leave blank for system default
AUDIO_DEVICE_ID=

# PulseAudio (Linux) — must match what docker-compose.yml mounts
PULSE_SERVER=unix:/run/pulse/native
VIRTUAL_MIC=virtual_mic

# NATS (optional — leave blank to disable interrupt feature)
NATS_URI=

# Log level for TTS
LOG_LEVEL=INFO


# ─────────────────────────────────────────
# Meeting-Bot
# ─────────────────────────────────────────
# Email prefix is used as the bot's display name in the meeting: "<prefix> (AI)"
BOT_EMAIL=bot@example.com
