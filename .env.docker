# ── Timezone ──────────────────────────────────────────────────────────────
TZ=Asia/Karachi

# ── MongoDB (Docker MongoDB Container) ──
# All containers use Docker MongoDB
MONGODB_URI=mongodb://mongodb:27017/?directConnection=true
MONGODB_DB=interviews
TRANSCRIPTS_COLLECTION=transcripts

# ── Redis (Real-time State Management) ──
# Used for bot/meeting state, pub/sub, caching, heartbeats
REDIS_URI=redis://redis:6379/0
REDIS_DB=0

# ── Main-Agent ────────────────────────────────────────────────────────────
LLM_PROVIDER=qwen
GEMINI_API_KEY=AIzaSyDwYEs_JvcFSVBU6zfzDTbdOPs-bV7ha8Q
GEMINI_MODEL_CONVERSATION=gemini-2.0-flash-lite
GEMINI_MODEL_EVALUATION=gemini-2.0-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=300
GEMINI_TEMPERATURE=0.7

# Qwen (via OpenRouter free tier)
OPENROUTER_API_KEY=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
QWEN_MODEL=qwen/qwen-2.5-72b-instruct:free

# ── TTS (Edge TTS — free, no API key required) ────────────────────────────
