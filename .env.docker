# ── Timezone ──────────────────────────────────────────────────────────────
TZ=Asia/Karachi

# ── MongoDB (Docker MongoDB Container) ──
MONGODB_URI=mongodb://mongodb:27017/?directConnection=true
MONGODB_DB=interviews
TRANSCRIPTS_COLLECTION=transcripts

# ── Redis (Real-time State Management) ──
REDIS_URI=redis://redis:6379/0
REDIS_DB=0

# ── Main-Agent ────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyDUrBYPSzweQ1f6_BxXjn27PLjNysijO_Y
GEMINI_MODEL_CONVERSATION=gemini-2.5-flash
GEMINI_MODEL_EVALUATION=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=300
