LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyDJWnU7kFI1siEG7pWT0UKvWcW1wG3WlF4
GEMINI_MODEL_CONVERSATION=gemini-2.5-flash
GEMINI_MODEL_EVALUATION=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_MAX_OUTPUT_TOKENS_COMBINED=800
GEMINI_TEMPERATURE=0.7
MAX_CONVERSATION_HISTORY=6

# Qwen via OpenRouter (working, ~$0.000005/request)
OPENROUTER_API_KEY=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
