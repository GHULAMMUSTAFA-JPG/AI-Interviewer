# ElevenLabs
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_22050

# MongoDB — point to interviews DB (must be a replica set for change streams)
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=interviews
TRANSCRIPTS_COLLECTION=transcripts

# NATS (optional — leave blank to disable interrupt feature)
NATS_URI=nats://localhost:4222

# Audio output device ID (run `uv run python -c "import sounddevice as sd; print(sd.query_devices())"` to list)
# Leave blank to use system default
AUDIO_DEVICE_ID=

# PulseAudio (Linux only)
PULSE_SERVER=unix:/run/user/1000/pulse/native
VIRTUAL_MIC=virtual_mic

# Logging
LOG_LEVEL=INFO
