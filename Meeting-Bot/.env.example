# MongoDB — must point to the same Atlas cluster as Main-Agent and TTS
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxxx.mongodb.net/?retryWrites=true&w=majority

# Bot Google account (used as the meeting guest display name)
BOT_EMAIL=bot@example.com

# Gemini API key (used for post-meeting summary generation)
GEMINI_API_KEY=your_gemini_api_key_here
