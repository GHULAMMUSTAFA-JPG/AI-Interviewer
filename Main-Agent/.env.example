# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=interviews

# -------------------------------------------------------
# LLM Provider — Options: "gemini" | "openai" | "anthropic"
# -------------------------------------------------------
LLM_PROVIDER=gemini

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Models — change here to switch without touching code
GEMINI_MODEL_CONVERSATION=gemini-2.5-flash   # Used for live interview turns
GEMINI_MODEL_EVALUATION=gemini-1.5-pro       # Used for post-interview scoring

# Gemini Generation Parameters
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.9

# -------------------------------------------------------
# OpenAI (set LLM_PROVIDER=openai to activate)
# -------------------------------------------------------
# OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo

# -------------------------------------------------------
# Anthropic (set LLM_PROVIDER=anthropic to activate)
# -------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4

# -------------------------------------------------------
# TTS Service
# -------------------------------------------------------
TTS_SERVICE_URL=http://localhost:8080/synthesize

# -------------------------------------------------------
# Interview Safeguards (optional — defaults shown)
# -------------------------------------------------------
SOFT_DURATION_LIMIT_MINUTES=90    # Warn candidate at this duration
HARD_DURATION_LIMIT_MINUTES=0     # Force-end at this duration (0 = disabled)
CONTEXT_WARNING_TOKENS=150000     # Warn when context approaches this
CONTEXT_MAX_TOKENS=180000         # Force-end when context exceeds this
SILENCE_TIMEOUT_SECONDS=180       # Mark interview abandoned after this silence

# -------------------------------------------------------
# Performance
# -------------------------------------------------------
MAX_CONCURRENT_INTERVIEWS=50      # Max parallel interviews
LLM_TIMEOUT_SECONDS=10            # Timeout per LLM call in seconds
CACHE_MAX_SIZE=1000               # Max cached interview contexts
CACHE_TTL_SECONDS=7200            # Cache TTL in seconds (2 hours)
