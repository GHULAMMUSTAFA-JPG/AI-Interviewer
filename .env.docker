# ── Timezone ──────────────────────────────────────────────────────────────
TZ=Asia/Karachi

# ── MongoDB (Docker MongoDB Container) ──
# Auth enabled — change the password here AND in docker-compose.yml (MONGO_INITDB_ROOT_PASSWORD)
MONGODB_URI=mongodb://admin:changeme_mongo@mongodb:27017/?directConnection=true&authSource=admin
MONGODB_DB=interviews
TRANSCRIPTS_COLLECTION=transcripts

# ── Redis (Real-time State Management) ──
# Auth enabled — change the password here AND in docker/redis/redis.conf (requirepass)
REDIS_URI=redis://:changeme_redis@redis:6379/0
REDIS_DB=0

# ── Main-Agent ────────────────────────────────────────────────────────────
